# ==============================================================================
# Scooter Rental System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment (staging/production)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=scooter_rent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secure_postgres_password_in_production
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Spring Boot Backend Settings
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Spring DataSource (points to the 'postgres' container in Docker network)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/scooter_rent_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this_secure_postgres_password_in_production

# JWT Authentication Secret (MUST be at least 32 characters / 256 bits)
JWT_SECRET=change_me_to_a_random_32_character_string_for_production_use!
JWT_EXPIRATION_MINUTES=720

# CORS & Application URLs
CORS_ORIGINS=http://65.0.5.214,http://localhost
APP_FRONTEND_URL=http://65.0.5.214

# Stripe Payments Configuration (SDS 4.2)
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# GPS & Device Authentication (X-Device-Key header)
GPS_DEVICE_API_KEY=your_secure_device_api_key_here

# AWS SES Notifications (SDS 4.1, 7.1) - Leave empty if email notifications not enabled
NOTIFICATIONS_EMAIL_PROVIDER=ses
NOTIFICATIONS_EMAIL_FROM=notifications@scooterrentkandy.lk
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload Directories (persisted via Docker volumes)
REPAIR_PHOTO_DIR=/app/data/repair-photos
PAYMENT_IMAGE_DIR=/app/data/payment-images
MANUAL_PAYMENT_VERIFICATION_TIMEOUT_MINUTES=120

# Customer Support Contact (optional)
SUPPORT_PHONE=+94812345678
SUPPORT_EMAIL=support@scooterrentkandy.lk

# ------------------------------------------------------------------------------
# Frontend Settings (Vite build-time args)
# Note: Keep VITE_API_URL empty when served via Nginx reverse proxy (/api)
# ------------------------------------------------------------------------------
VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
